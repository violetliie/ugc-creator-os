# ============================================================
# UGC CreatorOS: environment template
# Copy to .env.local for local dev. Never commit .env.local.
# Production: set these in your Vercel (app) and Render (worker) dashboards.
# ============================================================

# ---------- Supabase (create a free project at supabase.com) ----------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- Auth ----------
# Any long random string; signs the session JWT cookie.
# Generate one:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# ---------- Worker bridge ----------
# Shared secret between the Next.js app and the Python worker.
# Generate one:  openssl rand -hex 32
WORKER_SECRET=change-me-too
# Where the worker runs (Render URL in prod, localhost in dev)
WORKER_URL=http://localhost:10000

# ---------- Video stats vendor (Shortimize) ----------
# The worker pulls per-video view counts from Shortimize.
# Swap worker/shortimize.py for your own vendor if you use a different one.
SHORTIMIZE_API_KEY=your-shortimize-api-key
SHORTIMIZE_BASE_URL=https://api.shortimize.com

# ---------- Seed passwords (used by: python -m worker.seed_users) ----------
ADMIN_PASSWORD=changeme-admin
CREATOR_PASSWORD=changeme-creator

# ---------- Cron timing (UTC hours; optional overrides) ----------
CRON_HOUR_1_UTC=7
CRON_HOUR_2_UTC=19
CRON_HOUR_DAILY_ET=18

# ============================================================
# UGC CreatorOS: .gitignore
# Hardened to prevent any secrets reaching the repo.
# ============================================================

# ---------- Secrets / env ----------
.env
.env.*
!.env.example
*.env
secrets/
cookies.txt
*.pem
*.key
*.cert

# ---------- Node / Next.js ----------
node_modules/
.next/
out/
.vercel/
next-env.d.ts
.npm
.yarn/cache
.yarn/install-state.gz
.yarn/build-state.log
.pnpm-debug.log*

# ---------- Python / worker ----------
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
.python-version
*.egg-info/

# ---------- OS / IDE ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ---------- Logs / build artifacts ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/
dist/
build/
coverage/

# ---------- Local dev ----------
.tmp/
tmp/

# TypeScript incremental build info
*.tsbuildinfo
